DATABASE_URL="postgresql://user:password@localhost:5432/pockettiq?schema=public"

# Random 32+ byte secret used to sign session-related values. Generate with:
# openssl rand -hex 32
AUTH_SECRET="replace_me"

# NODE_ENV is set automatically by Next.js (development/production) — don't
# override it here, it disables the PWA service worker build if hardcoded.
APP_URL="http://localhost:3000"
